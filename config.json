{
    "vocab_size": 50000,
    "max_seq_len": 4096,

    "d_model": 2048,
    "num_layers": 20,
    "num_heads": 16,
    "num_kv_heads": 8,

    "mlp_type": "swiglu",
    "d_ff": 3584,

    "tie_embeddings": true,

    "rope_theta": 10000,
    "norm_eps": 1e-5,
    "init_std": 0.02,
    "dropout": 0.0,

    "batch_size": 8,
    "gradient_accumulation_steps": 16,

    "learning_rate": 3e-4,
    "min_learning_rate": 3e-5,
    "warmup_steps": 1000,
    "lr_schedule": "cosine",

    "beta1": 0.9,
    "beta2": 0.95,
    "adam_eps": 1e-8,

    "weight_decay": 0.1,
    "grad_clip": 1.0,

    "max_steps": 100000,
    "save_every": 5000,
    "eval_every": 1000,
    "save_best": true,

    "dtype": "bfloat16",
    "compile": true,

    "seed": 42
}